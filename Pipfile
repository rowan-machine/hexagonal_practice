[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
pyyaml = ">=6.0"
pandas = ">=2.0.0"
requests = ">=2.31.0"

[dev-packages]
pytest = ">=7.0.0"
pytest-cov = ">=4.0.0"
mypy = ">=1.0.0"
types-python-dateutil = ">=2.8.0"
black = ">=23.0.0"
ruff = ">=0.1.0"
jupyter = ">=1.0.0"
ipykernel = ">=6.0.0"
pre-commit = ">=3.0.0"
graphviz = "*"

[requires]
python_version = "3.8"

[scripts]
test = "pytest"
lint = "ruff check src/ scripts/ examples/"
format = "ruff check --fix src/ scripts/ examples/ && black src/ scripts/ examples/"
type-check = "mypy src/ --ignore-missing-imports"
coverage = "pytest --cov=src --cov-report=html --cov-report=term"

